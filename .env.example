# OfficePass — frontend environment template
# Copy to `.env` and fill in. Only NON-SECRET, browser-safe values belong here:
# everything prefixed with VITE_ is embedded in the shipped JS bundle.
#
# The Supabase anon key is public by design — data security is enforced by RLS.
# Secrets (service-role key, RESEND_API_KEY) go to Edge Function secrets only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
